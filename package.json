{
  "name": "opple-light-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run check:components && pnpm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:components": "node scripts/check-components.mjs",
    "test:browser": "pnpm run build && node tests/browser.cjs",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "ky": "^2.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.9.0"
}
