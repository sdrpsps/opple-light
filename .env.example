OPPLE_AUTH_DISABLED=1
# Leave empty to generate a persistent random access token.
OPPLE_TOKEN=
# Default compose.yaml uses native Linux host networking, fixed HTTP port 8080.
# Optional macOS compatibility file only:
OPPLE_PORT=8080
OPPLE_BIND_IP=0.0.0.0
OPPLE_UDP_RELAY=
OPPLE_RELAY_TOKEN=

# Optional Pocket ID mode. It overrides OPPLE_AUTH_DISABLED.
# OPPLE_AUTH_MODE=pocketid
# OPPLE_PUBLIC_URL=https://light.example.com
# OPPLE_OIDC_ISSUER=https://auth.example.com
# OPPLE_OIDC_CLIENT_ID=
# OPPLE_OIDC_CLIENT_SECRET=
# OPPLE_OIDC_RESOURCE=https://light.example.com/api
